<template>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div class="strip">
            <div class="strip__inner">
                <span class="strip__item">SMT ASSEMBLY / REFLOW</span>
                <span class="strip__item strip__item--mid">DOC OSMT-01 · REV 0 · UNRELEASED</span>
                <span class="strip__item strip__item--end">
                    <i class="led"></i>
                    LOCAL BUILD 0.0.0
                </span>
            </div>
        </div>
        <div class="site-header__inner">
            <Link to="IndexPage" class="brand">
                <span class="brand__mark">SMT</span>
                <span class="brand__text">
                    <span class="brand__name">OpenSMT</span>
                    <span class="brand__sub">place / feeder / reflow</span>
                </span>
            </Link>
            <nav id="primary-nav" aria-label="Primary" class="nav" :data-open="open ? 'true' : 'false'">
                <Link to="IndexPage" data-nav="home" :data-active="activeId === 'home' ? 'true' : 'false'">
                    Home
                </Link>
                <Link to="FeaturesPage" data-nav="features" :data-active="activeId === 'features' ? 'true' : 'false'">
                    Features
                </Link>
                <Link to="RoadmapPage" data-nav="roadmap" :data-active="activeId === 'roadmap' ? 'true' : 'false'">
                    Roadmap
                </Link>
            </nav>
            <div class="header-actions">
                <a class="nav-source" href="https://github.com/nyar-os/OpenSMT" rel="noopener">
                    SOURCE
                </a>
                <button
                    type="button"
                    class="menu-toggle"
                    @click="toggleMenu"
                    :aria-expanded="open ? 'true' : 'false'"
                    aria-controls="primary-nav"
                >
                    {{ menuLabel() }}
                </button>
            </div>
        </div>
    </header>
</template>

<style>
