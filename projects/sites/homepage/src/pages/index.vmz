<template>
    <SiteShell page="home">
        <section class="hero">
            <div class="hero__copy">
                <span class="tag">SMT planning · deterministic · unreleased</span>
                <h1>
                    Placement, feeders and reflow<br />
                    from one plain-text job.
                </h1>
                <p class="hero__sub">
                    OpenSMT keeps a board, a component list, a feeder table and a
                    reflow profile in a single <code>.osmt</code> document. A Rust
                    session owns validation, feeder allocation, placement
                    sequencing and profile evaluation; the CLI, Node-API addon and
                    TypeScript SDK are wrappers over that same core.
                    Unimplemented routes return
                    <code>capability/not-implemented</code>.
                </p>

                <dl class="spec">
                    <div class="spec__row">
                        <dt>Output</dt>
                        <dd>placement program · feeder sheet · reflow check</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Sequence</dt>
                        <dd>top side first · nearest component · refdes tie-break</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Units</dt>
                        <dd>mm · °C · mm/min, no conversion</dd>
                    </div>
                    <div class="spec__row">
                        <dt>Reports</dt>
                        <dd>program CSV · feeder CSV · JSON · Markdown</dd>
                    </div>
                </dl>

                <div class="hero__cta">
                    <Link to="FeaturesPage" class="btn btn--primary">
                        Open feature index
                    </Link>
                    <Link to="RoadmapPage" class="btn btn--ghost">
                        Read the gate log
                    </Link>
                </div>
            </div>

            <div class="sheet" aria-hidden="true">
                <div class="sheet__head">
                    <span class="sheet__no">SHEET 01 / 03</span>
                    <span>PLACE · FEED · REFLOW</span>
                    <span class="sheet__rev">REV 0</span>
                </div>

                <div class="draw">
                    <div class="draw__canvas">
                        <span class="board-face"></span>
                        <span class="part" style="left: 48px; top: 44px; width: 13px; height: 6.5px"></span>
                        <span class="part" style="left: 96px; top: 44px; width: 13px; height: 6.5px"></span>
                        <span class="part" style="left: 48px; top: 72px; width: 6.5px; height: 13px"></span>
                        <span class="qfn" style="left: 150px; top: 96px; width: 40px; height: 40px"></span>
                        <span class="part" style="left: 78px; top: 132px; width: 13px; height: 6.5px"></span>
                        <span class="dim" style="left: 24px; top: 180px; width: 240px"></span>
                        <span class="dim__tick" style="left: 24px; top: 176px"></span>
                        <span class="dim__tick" style="left: 264px; top: 176px"></span>
                        <span class="dim-label">30 mm</span>
                        <span class="note">0603 · QFN-32 · F1 / F2</span>
                    </div>
                </div>

                <div class="readout">
                    <div class="readout__row">
                        <span>components</span>
                        <b>{{ components }}</b>
                        <i>placed</i>
                    </div>
                    <div class="readout__row">
                        <span>feeders</span>
                        <b>{{ feeders }}</b>
                        <i>lanes</i>
                    </div>
                    <div class="readout__row">
                        <span>cycle time</span>
                        <b>{{ cycleTime }}</b>
                        <i>s</i>
                    </div>
                    <div class="readout__row readout__row--ok">
                        <span>time &gt; liquidus</span>
                        <b>{{ timeAbove }}</b>
                        <i>s</i>
                    </div>
                </div>

                <div class="sheet__foot">
                    <span>$ open-smt placement panel.osmt</span>
                    <span>exit 0</span>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">01</span>Capability matrix</h2>
                <p>What this build plans, and what fails with a stable error code.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Capability</th>
                            <th>Method</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in capabilityRows" :key="row.code">
                            <td class="name">{{ row.code }}</td>
                            <td>{{ row.capability }}</td>
                            <td class="method">{{ row.method }}</td>
                            <td><span :class="statusChip(row.status)">{{ row.status }}</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                The machine-readable matrix is printed by
                <code>open-smt capabilities</code> and matches actual behaviour.
            </p>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">02</span>One core, four surfaces</h2>
                <p>No allocation or reflow rule is reimplemented in a binding.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr>
                            <th>Surface</th>
                            <th>Package</th>
                            <th>Responsibility</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="name">Rust session</td>
                            <td class="name">smt-model</td>
                            <td>Document I/O, editing, validation, allocation, sequencing, reflow and reports.</td>
                        </tr>
                        <tr>
                            <td class="name">Node-API</td>
                            <td class="name">smt-napi</td>
                            <td>Orthogonal functions over the session; each returns JSON.</td>
                        </tr>
                        <tr>
                            <td class="name">TypeScript SDK</td>
                            <td class="name">@wae/open-smt</td>
                            <td><code>new OpenSMT()</code> session, <code>SmtDocument</code> documents, atomic save.</td>
                        </tr>
                        <tr>
                            <td class="name">CLI</td>
                            <td class="name">open-smt</td>
                            <td>Argument parsing, JSON output and exit codes <code>0</code> / <code>1</code> / <code>2</code> only.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">03</span>Workflow</h2>
                <p>Declare, validate, allocate, sequence, evaluate.</p>
            </div>
            <ol class="flow">
                <li class="flow-step">
                    <span class="flow-index">01</span>
                    <h3>Declare</h3>
                    <p>Create an <code>.osmt</code> file with a board, components, feeders and a profile.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">02</span>
                    <h3>Validate</h3>
                    <p>Check coordinates, duplicate refdes, feeder coverage and the profile.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">03</span>
                    <h3>Sequence</h3>
                    <p>Allocate lanes by id, then visit the nearest component, top side first.</p>
                    <span class="chip chip--available">available</span>
                </li>
                <li class="flow-step">
                    <span class="flow-index">04</span>
                    <h3>Evaluate</h3>
                    <p>Integrate time above liquidus over linear zone ramps.</p>
                    <span class="chip chip--available">available</span>
                </li>
            </ol>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">04</span>Deterministic by construction</h2>
                <p>No timestamps, no randomised tie-breaks, no vendor dialect.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr>
                            <th>Rule</th>
                            <th>Consequence</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="name">feeder allocation</td>
                            <td class="method">smallest id with remaining loaded parts wins</td>
                        </tr>
                        <tr>
                            <td class="name">nearest neighbour</td>
                            <td class="method">ties break by reference designator</td>
                        </tr>
                        <tr>
                            <td class="name">side order</td>
                            <td class="method">top side first, each side starts at the origin</td>
                        </tr>
                        <tr>
                            <td class="name">reflow</td>
                            <td class="method">linear zone ramps, integrated crossings</td>
                        </tr>
                        <tr>
                            <td class="name">reports</td>
                            <td class="method">byte-identical on repeated runs</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">05</span>Scope</h2>
                <p>A narrow assembly planner with an explicit boundary.</p>
            </div>
            <div class="grid-2">
                <article class="card scope-card scope-card--in">
                    <span class="chip chip--available">in scope</span>
                    <h3>Implemented today</h3>
                    <ul>
                        <li>Rectangular boards and panel arrays</li>
                        <li>Top and bottom side components</li>
                        <li>Deterministic nearest-first placement program</li>
                        <li>Feeder allocation by id and loaded quantity</li>
                        <li>Multi-feeder split of one package</li>
                        <li>Panel board count and panel dimensions</li>
                        <li>Reflow peak and time above liquidus</li>
                        <li>Program CSV, feeder CSV, JSON and Markdown</li>
                    </ul>
                </article>
                <article class="card scope-card scope-card--out">
                    <span class="chip chip--blocked">out of scope</span>
                    <h3>Rejected, not approximated</h3>
                    <ul>
                        <li>Paste aperture and stencil generation</li>
                        <li>Vendor machine programs (Fuji, Yamaha, Juki, ASM)</li>
                        <li>Line balancing</li>
                        <li>Dual-lane scheduling</li>
                        <li>KiCad, Altium and ODB import</li>
                        <li>Nozzle and head optimisation</li>
                    </ul>
                </article>
            </div>
        </section>

        <section class="status-band">
            <div>
                <span class="eyebrow">Build status</span>
                <h2>The planner is real. The interface is the terminal.</h2>
                <p>
                    Declare a panel, allocate feeders, generate the program and
                    read the reflow numbers today. Each unimplemented route fails
                    with <code>capability/not-implemented</code> and exit code
                    <code>2</code>.
                </p>
            </div>
            <Link to="RoadmapPage" class="btn btn--ghost">Read the gate log</Link>
        </section>

        <p class="cta-line">
            Want the detailed surface?
            <Link to="FeaturesPage">Read the feature index</Link>
            .
        </p>
    </SiteShell>
</template>

<style>
.hero {
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    gap: 40px;
    align-items: start;
    padding: 26px 0 4px;
}

.hero h1 {
    margin: 14px 0 16px;
    font-size: 35px;
}

.hero__sub {
    max-width: 560px;
    margin: 0 0 22px;
    color: var(--smt-muted);
    font-size: 15.5px;
}

.spec {
    margin: 0 0 24px;
    border-top: 1px solid var(--smt-line);
}

.spec__row {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--smt-line);
}

.spec dt {
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-top: 2px;
}

.spec dd {
    margin: 0;
    font-family: var(--smt-mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
}

.hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.sheet {
    border: 1px solid var(--smt-line-strong);
    background: var(--smt-surface);
    box-shadow: 6px 6px 0 rgba(16, 23, 28, 0.06);
}

.sheet__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 9px;
    border-bottom: 1px solid var(--smt-line-strong);
    background: var(--smt-surface-2);
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 8.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.sheet__no {
    color: var(--smt-ink);
    font-weight: 600;
}

.sheet__rev {
    margin-left: auto;
    padding: 0 5px;
    border: 1px solid var(--smt-line-strong);
    background: var(--smt-surface);
    color: var(--smt-ink);
}

.draw {
    padding: 12px 8px 8px;
    border-bottom: 1px solid var(--smt-line);
    background:
        linear-gradient(to right, rgba(16, 23, 28, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(16, 23, 28, 0.05) 1px, transparent 1px);
    background-size: 12px 12px;
}

.draw__canvas {
    position: relative;
    width: 280px;
    height: 200px;
    margin: 0 auto;
}

.board-face {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 240px;
    height: 148px;
    border: 1px solid var(--smt-ink);
    background: rgba(255, 255, 255, 0.55);
}

.part {
    position: absolute;
    border: 1px solid var(--smt-accent);
    background: var(--smt-accent-soft);
}

.qfn {
    position: absolute;
    border: 1px solid var(--smt-stop);
    background: var(--smt-stop-soft);
}

.qfn::after {
    content: "";
    position: absolute;
    inset: 6px;
    border: 1px dashed var(--smt-stop);
    opacity: 0.6;
}

.dim {
    position: absolute;
    height: 1px;
    background: var(--smt-line-strong);
}

.dim__tick {
    position: absolute;
    width: 1px;
    height: 6px;
    background: var(--smt-line-strong);
}

.dim-label {
    position: absolute;
    left: 118px;
    top: 172px;
    padding: 0 4px;
    background: var(--smt-surface);
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 8px;
    letter-spacing: 0.06em;
}

.note {
    position: absolute;
    left: 24px;
    top: 186px;
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 8px;
    letter-spacing: 0.05em;
}

.readout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--smt-line);
}

.readout__row {
    display: grid;
    grid-template-columns: 1fr auto 56px;
    align-items: baseline;
    gap: 8px;
    padding: 5px 9px;
    border-right: 1px solid var(--smt-line);
    border-bottom: 1px solid var(--smt-line);
    font-family: var(--smt-mono);
    font-size: 9px;
}

.readout__row:nth-child(2n) {
    border-right: 0;
}

.readout__row:nth-last-child(-n + 2) {
    border-bottom: 0;
}

.readout__row span {
    color: var(--smt-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.readout__row b {
    color: var(--smt-ink);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
}

.readout__row i {
    color: var(--smt-muted);
    font-size: 8px;
    font-style: normal;
    text-align: right;
}

.readout__row--ok b {
    color: var(--smt-ok);
}

.sheet__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 9px;
    background: var(--smt-surface-2);
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 8px;
    letter-spacing: 0.03em;
}

.method {
    color: var(--smt-muted);
    font-family: var(--smt-mono);
    font-size: 11px;
}

.flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--smt-line-strong);
    background: var(--smt-surface);
}

.flow-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    padding: 16px 14px;
    border-right: 1px solid var(--smt-line);
}

.flow-step:last-child {
    border-right: 0;
}

.flow-index {
    color: var(--smt-accent-ink);
    font-family: var(--smt-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
}

.flow-step h3 {
    margin: 0;
    font-size: 14px;
}

.flow-step p {
    flex: 1;
    margin: 0 0 6px;
    color: var(--smt-muted);
    font-size: 12.5px;
}

.scope-card {
    padding-top: 16px;
}

.scope-card--in {
    border-top-color: var(--smt-ok);
}

.scope-card--out {
    border-top-color: var(--smt-stop);
}

.scope-card ul {
    margin-top: 8px;
    padding-left: 18px;
}

.scope-card li {
    margin: 4px 0;
    font-size: 13px;
}

.status-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 36px;
    padding: 18px 20px;
    border: 1px solid var(--smt-line-strong);
    border-left: 4px solid var(--smt-accent);
    background: var(--smt-surface);
}

.status-band h2 {
    margin: 6px 0 6px;
    font-size: 19px;
}

.status-band p {
    max-width: 720px;
    margin: 0;
    color: var(--smt-muted);
    font-size: 13.5px;
}

@media (max-width: 980px) {
    .hero {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .sheet {
        max-width: 460px;
    }

    .flow {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .flow-step:nth-child(2) {
        border-right: 0;
    }

    .flow-step:nth-child(-n + 2) {
        border-bottom: 1px solid var(--smt-line);
    }
}

@media (max-width: 620px) {
    .hero h1 {
        font-size: 27px;
    }

    .spec__row {
        grid-template-columns: 1fr;
        gap: 1px;
    }

    .flow {
        grid-template-columns: 1fr;
    }

    .flow-step {
        border-right: 0;
        border-bottom: 1px solid var(--smt-line);
    }

    .flow-step:last-child {
        border-bottom: 0;
    }
}

@media (max-width: 380px) {
    .draw {
        overflow: hidden;
    }

    .draw__canvas {
        transform: scale(0.88);
        transform-origin: top center;
        margin-bottom: -24px;
    }
}
</style>

<script client>
const CAPABILITY_ROWS = [
    { code: "PLACE", capability: "Placement sequence", method: "nearest-first, top side first", status: "available" },
    { code: "FEEDER", capability: "Feeder allocation", method: "smallest id with loaded parts", status: "available" },
    { code: "SPLIT", capability: "Multi-feeder package", method: "split in id order", status: "available" },
    { code: "PANEL", capability: "Panel arithmetic", method: "board count, width and depth with gaps", status: "available" },
    { code: "REFLOW", capability: "Reflow evaluation", method: "peak and time above liquidus", status: "available" },
    { code: "PROGRAM", capability: "Placement program", method: "CSV with index, refdes, feeder", status: "available" },
    { code: "SHEET", capability: "Feeder setup sheet", method: "CSV with assigned and remaining", status: "available" },
    { code: "PASTE", capability: "Paste apertures", method: "not implemented", status: "blocked" },
    { code: "VENDOR", capability: "Vendor programs", method: "not implemented", status: "blocked" },
    { code: "BALANCE", capability: "Line balancing", method: "not implemented", status: "blocked" },
    { code: "LANE2", capability: "Dual lane", method: "not implemented", status: "blocked" },
    { code: "IMPORT", capability: "KiCad / Altium / ODB", method: "not implemented", status: "blocked" },
];

export default class IndexPage {
    public capabilityRows: typeof CAPABILITY_ROWS = CAPABILITY_ROWS;
    public components = "5";
    public feeders = "2";
    public cycleTime = "1.94";
    public timeAbove = "18.13";

    static meta() {
        return {
            title: "OpenSMT - deterministic placement, feeder and reflow planning",
            description:
                "OpenSMT keeps one .osmt document for placement sequencing, feeder allocation, panelization and reflow evaluation, with deterministic CSV, JSON and Markdown reports.",
        };
    }

    statusChip(status: string) {
        if (status === "available") return "chip chip--available";
        if (status === "limited") return "chip chip--limited";
        return "chip chip--blocked";
    }
}
</script>
