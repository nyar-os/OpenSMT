<script client>
const CLOSED = [
    { gate: "Document model", evidence: "format/version/units validation, atomic save" },
    { gate: "Components", evidence: "side, rotation and board-bound checks" },
    { gate: "Panelization", evidence: "board count, width and depth with gaps" },
    { gate: "Feeder allocation", evidence: "id order, loaded quantity, multi-lane split" },
    { gate: "Placement program", evidence: "nearest-first, top side first, refdes tie-break" },
    { gate: "Reflow", evidence: "linear ramps and exact liquidus crossings" },
    { gate: "Reports", evidence: "program CSV, feeder CSV, JSON and Markdown" },
    { gate: "Determinism", evidence: "byte-identical repeated reports" },
    { gate: "SDK and CLI", evidence: "one session behind both surfaces" },
];

const NEXT = [
    { gate: "Paste apertures", reason: "no stencil or aperture model" },
    { gate: "Vendor programs", reason: "only the neutral placement CSV exists" },
    { gate: "Line balancing", reason: "single machine, single lane" },
    { gate: "Dual lane", reason: "no lane scheduling model" },
    { gate: "KiCad / Altium / ODB", reason: "components must currently be declared as numbers" },
    { gate: "Nozzle / head optimisation", reason: "the sequence ignores machine heads" },
];

export default class RoadmapPage {
    public closed: typeof CLOSED = CLOSED;
    public next: typeof NEXT = NEXT;

    static meta() {
        return {
            title: "OpenSMT gate log",
            description:
                "Closed gates with test evidence and the explicitly unimplemented capabilities of OpenSMT.",
        };
    }
}
</script>
