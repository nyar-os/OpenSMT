<template>
    <SiteShell page="roadmap">
        <header class="page-head">
            <span class="eyebrow">Gate log</span>
            <h1>What is closed, what is next</h1>
            <p class="lead">
                OpenSMT grows by closing verifiable slices. A row is only closed
                when a test asserts it and the capability matrix says so.
            </p>
        </header>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">01</span>Closed</h2>
                <p>Implemented, tested and exposed through every surface.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr><th>Gate</th><th>Evidence</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in closed" :key="row.gate">
                            <td class="name">{{ row.gate }}</td>
                            <td class="method">{{ row.evidence }}</td>
                            <td><span class="chip chip--available">closed</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="section">
            <div class="section-head">
                <h2><span class="section-index">02</span>Next</h2>
                <p>Not implemented; every entry fails explicitly today.</p>
            </div>
            <div class="table-wrap">
                <table class="matrix">
                    <thead>
                        <tr><th>Gate</th><th>Why it is not closed</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr v-for="row in next" :key="row.gate">
                            <td class="name">{{ row.gate }}</td>
                            <td class="method">{{ row.reason }}</td>
                            <td><span class="chip chip--blocked">open</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                Unimplemented routes return
                <code>capability/not-implemented</code> and exit code
                <code>2</code>; they never approximate a result.
            </p>
        </section>

        <section class="status-band">
            <div>
                <span class="eyebrow">Rule of the log</span>
                <h2>No claim without a test.</h2>
                <p>
                    A gate moves to closed only when the engine, the Node-API
                    surface, the SDK, the CLI, the capability matrix and at least
                    one test agree.
                </p>
            </div>
            <Link to="FeaturesPage" class="btn btn--ghost">Read the feature index</Link>
        </section>

        <p class="cta-line">
            <Link to="IndexPage">Back to the overview</Link>
        </p>
    </SiteShell>
</template>

