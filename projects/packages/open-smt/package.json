{
    "name": "@wae/open-smt",
    "version": "0.0.0",
    "private": true,
    "description": "Deterministic SMT placement programs, feeder setup and reflow analysis",
    "license": "MPL-2.0",
    "type": "module",
    "engines": {
        "node": ">=22.6"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-smt": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/smoke.test.js"
    },
    "keywords": [
        "smt",
        "pcba",
        "placement",
        "feeder",
        "reflow",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenSMT.git",
        "directory": "projects/packages/open-smt"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "optionalDependencies": {
        "@wae/open-smt-darwin-arm64": "workspace:*",
        "@wae/open-smt-darwin-x64": "workspace:*",
        "@wae/open-smt-linux-arm64": "workspace:*",
        "@wae/open-smt-linux-x64": "workspace:*",
        "@wae/open-smt-win32-x64": "workspace:*"
    }
}
